FROM node:20-alpine AS dev

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm install
COPY frontend ./

ARG VITE_KBASE_DEPLOYMENT_LABEL=dev
ARG VITE_KBASE_GIT_BRANCH=unknown
ARG VITE_KBASE_GIT_COMMIT=unknown
ARG VITE_KBASE_GIT_COMMIT_DATE=
ENV VITE_KBASE_DEPLOYMENT_LABEL=${VITE_KBASE_DEPLOYMENT_LABEL}
ENV VITE_KBASE_GIT_BRANCH=${VITE_KBASE_GIT_BRANCH}
ENV VITE_KBASE_GIT_COMMIT=${VITE_KBASE_GIT_COMMIT}
ENV VITE_KBASE_GIT_COMMIT_DATE=${VITE_KBASE_GIT_COMMIT_DATE}


FROM node:20-alpine AS build

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./

ARG VITE_API_BASE_URL=/
ARG VITE_KBASE_DEPLOYMENT_LABEL=prod
ARG VITE_KBASE_GIT_BRANCH=unknown
ARG VITE_KBASE_GIT_COMMIT=unknown
ARG VITE_KBASE_GIT_COMMIT_DATE=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_KBASE_DEPLOYMENT_LABEL=${VITE_KBASE_DEPLOYMENT_LABEL}
ENV VITE_KBASE_GIT_BRANCH=${VITE_KBASE_GIT_BRANCH}
ENV VITE_KBASE_GIT_COMMIT=${VITE_KBASE_GIT_COMMIT}
ENV VITE_KBASE_GIT_COMMIT_DATE=${VITE_KBASE_GIT_COMMIT_DATE}

RUN npm run build


FROM nginx:1.27-alpine AS prod

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html
